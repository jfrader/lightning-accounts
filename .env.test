USERID=1000
GROUPID=1000
NODE_ENV=test
NODE_PORT=3999
NODE_DOMAIN=
NODE_ORIGIN=http://localhost:2991
NODE_TRUSTED_PROXY_IP=127.0.0.1
NODE_DEBUG_LEVEL=debug
SEED_HASH_SECRET=local-test-seed-secret
# Test-only seed credentials; prisma/seed.ts refuses to run outside development/test.
SEED_APP_EMAIL=admin@trucoshi.com
SEED_APP_PASSWORD=test-app-password
SEED_ADMIN_EMAIL=admin_test@trucoshi.com
SEED_ADMIN_PASSWORD=test-admin-password
SEED_E2E_PASSWORD=secret
NODE_DB_NAME=lnaccounts_test
NODE_DB_USER=lnaccounts_user
NODE_DB_PASSWORD=lnaccounts_password
DATABASE_URL=postgresql://lnaccounts_user:lnaccounts_password@localhost:5432/lnaccounts_test?schema=public
JWT_COOKIE_PREFIX=
JWT_SECRET=local-test-cookie-secret
# Jest generates ephemeral keys. Supply local keys for standalone test servers.
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
WALLET_LIMIT=100000
WALLET_RECONCILE_DRY_RUN=0
