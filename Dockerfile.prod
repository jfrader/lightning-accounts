# Build the TypeScript server and generated API artifacts with pinned tooling.
FROM node:24.18.0-alpine AS builder

WORKDIR /opt/app

RUN test "$(yarn --version)" = "1.22.22"

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false

COPY prisma ./prisma
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json tsconfig.build.json tsconfig.test.json tsconfig.dist.json ./

RUN mkdir -p dist
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public yarn build

# Install only runtime dependencies and copy the compiled output into the final image.
FROM node:24.18.0-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /opt/app

RUN test "$(yarn --version)" = "1.22.22"

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=true --ignore-scripts

COPY prisma ./prisma
# The JSON-schema generator is build-only and therefore is not installed in this
# production-dependencies-only stage. Generate just the runtime Prisma client.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public ./node_modules/.bin/prisma generate --generator client

COPY bin ./bin
COPY --from=builder /opt/app/build ./build
COPY --from=builder /opt/app/dist ./dist
COPY --from=builder /opt/app/src ./src

# Load the production application without starting the HTTP server. This catches
# build-only dependencies that accidentally leak into the runtime import graph.
RUN node -e "const fs=require('node:fs');const {generateKeyPairSync}=require('node:crypto');const {publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});fs.writeFileSync('/tmp/jwt-public.b64',Buffer.from(publicKey).toString('base64'));fs.writeFileSync('/tmp/jwt-private.b64',Buffer.from(privateKey).toString('base64'))" \
  && NODE_ENV=production \
  NODE_ORIGIN=https://web.build.invalid \
  NODE_HOST=https://accounts.build.invalid \
  NODE_DOMAIN=.build.invalid \
  NODE_TRUST_PROXY_HOPS=0 \
  NODE_PORT=2999 \
  WALLET_ENABLED=0 \
  APPLICATION_EMAILS=game-build@build.invalid \
  JWT_SECRET=0123456789abcdef0123456789abcdef \
  JWT_BASE64_PUBLIC_KEY="$(cat /tmp/jwt-public.b64)" \
  JWT_BASE64_PRIVATE_KEY="$(cat /tmp/jwt-private.b64)" \
  SEED_HASH_SECRET=fedcba9876543210fedcba9876543210 \
  SMTP_HOST=smtp.build.invalid \
  SMTP_PORT=587 \
  SMTP_USERNAME=build-user \
  SMTP_PASSWORD=abcdef0123456789abcdef0123456789 \
  EMAIL_FROM=build@build.invalid \
  DATABASE_URL='postgresql://lightning_accounts_app:build@localhost:5432/lightning_accounts?schema=public&connection_limit=10&sslmode=require' \
  node -e "require('./build/src/app.js')" \
  && rm -f /tmp/jwt-public.b64 /tmp/jwt-private.b64

RUN chown -R node:node /opt/app

USER node
EXPOSE 2999
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const http=require('node:http');const request=http.get({host:'127.0.0.1',port:process.env.PORT||process.env.NODE_PORT||2999,path:'/health/ready'},response=>{response.resume();process.exit(response.statusCode===200?0:1)});request.on('error',()=>process.exit(1));request.setTimeout(4000,()=>{request.destroy();process.exit(1)})"

CMD ["node", "bin/lightning-accounts-server"]
